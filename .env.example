# Copy to .env and adjust. Everything here is optional.

# Port and bind address of the web UI. Keep 127.0.0.1 on desktops; on a server use 0.0.0.0
# together with a password (and ideally a reverse proxy with TLS).
PLAINBOARD_PORT=8080
PLAINBOARD_BIND=127.0.0.1
PLAINBOARD_PASSWORD=

# Folder the agents work in. Default: a Docker volume. Desktop users can point this to a host
# folder (e.g. D:/Code or /home/me/code) and set a project's "Local folder" to a sub folder.
# PLAINBOARD_WORKSPACES_DIR=D:/Code

# The browser window shows pages of the agents' servers as they are at localhost. It needs Chromium
# in the runner image (about 700 MB). Set to 0 and rebuild to leave it out.
# PLAINBOARD_BROWSER=1

# PlainBoard shows a notice when its repository on GitHub has newer commits than the running build
# (turn it off under Settings). A fork names its own repository here.
# PLAINBOARD_UPDATE_REPOSITORY=hthoene/plainboard

# Credentials are normally entered in the UI (Settings). These are optional fallbacks for accounts
# without a token or key of their own:
# Anthropic API key (recommended)
PLAINBOARD_ANTHROPIC_API_KEY=
# or your own Claude login token, created with `claude setup-token` (see "Good to know" in the README)
PLAINBOARD_CLAUDE_CODE_OAUTH_TOKEN=
# OpenAI API key for Codex agents. Not needed with a ChatGPT subscription: sign in under Settings → Codex.
PLAINBOARD_OPENAI_API_KEY=
# Fine-grained GitHub personal access token (optional)
PLAINBOARD_GITHUB_TOKEN=
